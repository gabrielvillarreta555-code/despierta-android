# Versión que se firma para Google Play. Solo datos públicos: aquí NUNCA van claves ni contraseñas.
# Para una versión nueva: cambia estos valores en un PR y el flujo "AAB firmado para Google Play"
# la compila desde ese commit exacto, la firma con la clave de subida y la verifica.

# Commit del código de la app que se publica (rama release/2.9).
APP_COMMIT=8be24840148c14183e069c9c2c1c5e951f28ca94
PACKAGE_NAME=com.bluelabstudios.despierta
VERSION_NAME=2.9
VERSION_CODE=12

# Huella SHA-256 del certificado de la clave de SUBIDA (pública). Debe coincidir con el
# "Certificado de clave de subida" de Play Console → Integridad de la app → Firma de apps.
# Si Play Console muestra otra huella, NO cambies este valor por la de esta clave: avisa primero.
UPLOAD_CERT_SHA256=C6:03:44:32:7C:B5:8F:3C:6D:FE:DA:56:02:13:CA:EC:6B:D0:70:84:02:B9:EC:B0:19:DE:69:CD:20:9C:64:54
